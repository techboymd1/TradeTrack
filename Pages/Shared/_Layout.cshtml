@{
    var isDashboard = ViewData["TradeTrackDashboard"] is bool dashboard && dashboard;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - TradeTrack</title>

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
</head>

<body class="@(isDashboard ? "dashboard-body" : "standard-body")">

    @if (isDashboard)
    {
        @RenderBody()
    }
    else
    {
        <header class="standard-header">
            <nav class="standard-nav" aria-label="Main navigation">
                <a class="standard-brand" asp-page="/Index">
                    TradeTrack
                </a>

                <a class="standard-nav-link" asp-page="/Privacy">
                    Privacy
                </a>
            </nav>
        </header>

        <div class="standard-container">
            @RenderBody()
        </div>

        <footer class="standard-footer">
            <div class="standard-footer-inner">
                TradeTrack
            </div>
        </footer>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>