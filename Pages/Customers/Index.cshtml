@page
@model TradeTrack.Pages.Customers.IndexModel

@{
    ViewData["Title"] = "Customers";
    ViewData["TradeTrackDashboard"] = true;
}

<div class="app-shell">

    <partial name="_Sidebar" />

    <main class="main-panel">

        <header class="topbar">
            <div class="breadcrumb">
                <span>Workspace</span>
                <span>/</span>
                <strong>Customers</strong>
            </div>

            <div class="topbar-right">
                <a class="dashboard-primary-button"
                   asp-page="/Customers/Create">+ Add Customer</a>
                <span class="profile-avatar">MB</span>
            </div>
        </header>

        <div class="page-content">

            <section class="inventory-header">
                <div>
                    <p class="eyebrow">BUSINESS MANAGEMENT</p>
                    <h1>Customers</h1>
                    <p class="page-description">
                        Manage customer information and business relationships.
                    </p>
                </div>
            </section>

            @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
            {
                <div class="inventory-notice inventory-success">
                    @Model.SuccessMessage
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.LoadError))
            {
                <div class="inventory-notice inventory-error">
                    @Model.LoadError
                </div>
            }

            <section class="inventory-summary">

                <article class="inventory-summary-card">
                    <span class="inventory-summary-label">Total Customers</span>
                    <strong>@Model.TotalCustomers</strong>
                </article>

                <article class="inventory-summary-card">
                    <span class="inventory-summary-label">Active Customers</span>
                    <strong>@Model.ActiveCustomers</strong>
                </article>

                <article class="inventory-summary-card">
                    <span class="inventory-summary-label">Inactive Customers</span>
                    <strong>@Model.InactiveCustomers</strong>
                </article>

            </section>

            <section class="inventory-section">

                <div class="inventory-section-heading">
                    <div>
                        <h2>Customer Directory</h2>
                        <p>Registered customer records.</p>
                    </div>
                </div>

                <div class="inventory-table-container">

                    <table class="inventory-table">

                        <thead>
                            <tr>
                                <th>Customer</th>
                                <th>Phone</th>
                                <th>Email</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            @if (Model.Customers.Count > 0)
                            {
                                @foreach (var customer in Model.Customers)
                                {
                                    <tr>
                                        <td class="inventory-product-name">
                                            @customer.FullName
                                        </td>

                                        <td>@(customer.Phone ?? "—")</td>
                                        <td>@(customer.Email ?? "—")</td>

                                        <td>
                                            @if (customer.IsActive)
                                            {
                                                <span class="stock-badge stock-badge--in-stock">
                                                    Active
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="stock-badge stock-badge--inactive">
                                                    Inactive
                                                </span>
                                            }
                                        </td>

                                        <td>
                                            <div class="customer-actions">

                                                <a class="expense-edit-link"
                                                   asp-page="/Customers/Edit"
                                                   asp-route-id="@customer.CustomerId">
                                                    Edit
                                                </a>

                                                <form method="post"
                                                      asp-page-handler="ToggleStatus"
                                                      asp-route-id="@customer.CustomerId">

                                                    <button type="submit"
                                                            class="customer-status-button">
                                                        @(customer.IsActive ? "Deactivate" : "Activate")
                                                    </button>

                                                </form>

                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5">
                                        <div class="inventory-empty-state">
                                            <h3>No Customers Found</h3>
                                            <p>Registered customers will appear here.</p>

                                            <a class="dashboard-primary-button"
                                               asp-page="/Customers/Create">
                                                + Add First Customer
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }

                        </tbody>
                    </table>

                </div>

            </section>

            <footer class="dashboard-footer">
                <span>TradeTrack · Business Management System</span>
                <span>All rights reserved.</span>
            </footer>

        </div>
    </main>
</div>