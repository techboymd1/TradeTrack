@page
@model TradeTrack.Pages.Customers.CreateModel

@{
    ViewData["Title"] = "Add Customer";
    ViewData["TradeTrackDashboard"] = true;
}

<div class="app-shell">

    <partial name="_Sidebar" />

    <main class="main-panel">

        <header class="topbar">
            <div class="breadcrumb">
                <a asp-page="/Customers/Index">Customers</a>
                <span>/</span>
                <strong>Add Customer</strong>
            </div>

            <div class="topbar-right">
                <a class="dashboard-secondary-button"
                   asp-page="/Customers/Index">Back to Customers</a>
                <span class="profile-avatar">MB</span>
            </div>
        </header>

        <div class="page-content">

            <section class="expense-create">

                <header class="expense-page-heading">
                    <p class="eyebrow">CUSTOMER MANAGEMENT</p>
                    <h1>Add Customer</h1>
                    <p class="page-description">
                        Create a customer record.
                    </p>
                </header>

                <form method="post" class="expense-form">

                    <div asp-validation-summary="ModelOnly"
                         class="expense-validation"></div>

                    <div class="expense-form-grid">

                        <div class="expense-field expense-full-width">
                            <label asp-for="Customer.FullName">Full Name</label>
                            <input asp-for="Customer.FullName"
                                   class="expense-control"
                                   placeholder="Enter customer name" />
                            <span asp-validation-for="Customer.FullName"
                                  class="expense-error"></span>
                        </div>

                        <div class="expense-field">
                            <label asp-for="Customer.Phone">Phone Number</label>
                            <input asp-for="Customer.Phone"
                                   type="tel"
                                   class="expense-control"
                                   placeholder="Phone number" />
                            <span asp-validation-for="Customer.Phone"
                                  class="expense-error"></span>
                        </div>

                        <div class="expense-field">
                            <label asp-for="Customer.Email">Email Address</label>
                            <input asp-for="Customer.Email"
                                   type="email"
                                   class="expense-control"
                                   placeholder="Email address" />
                            <span asp-validation-for="Customer.Email"
                                  class="expense-error"></span>
                        </div>

                        <div class="expense-field expense-full-width">
                            <label asp-for="Customer.Address">Address</label>
                            <input asp-for="Customer.Address"
                                   class="expense-control"
                                   placeholder="Customer address" />
                        </div>

                        <div class="expense-field expense-full-width">
                            <label asp-for="Customer.Notes">Notes</label>
                            <textarea asp-for="Customer.Notes"
                                      class="expense-control"
                                      rows="4"
                                      placeholder="Additional customer information"></textarea>
                        </div>

                    </div>

                    <div class="expense-actions">
                        <button type="submit" class="expense-save-button">
                            Save Customer
                        </button>

                        <a asp-page="/Customers/Index"
                           class="product-create__cancel">
                            Cancel
                        </a>
                    </div>

                </form>

            </section>
        </div>
    </main>
</div>