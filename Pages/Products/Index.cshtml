@page
@model TradeTrack.Pages.Products.ProductIndexModel

@{
    ViewData["Title"] = "Products & Stock";
    ViewData["TradeTrackDashboard"] = true;
}

<div class="app-shell">

    <partial name="_Sidebar" />

    <main class="main-panel">

        <header class="topbar">

            <div class="breadcrumb">
                <span>Workspace</span>
                <span aria-hidden="true">/</span>
                <strong>Products & Stock</strong>
            </div>

            <div class="topbar-right">

                <a class="dashboard-primary-button" asp-page="/Products/Create">
                    <span aria-hidden="true">+</span>
                    Add Product
                </a>

                <span class="profile-avatar" aria-label="Business profile">
                    MB
                </span>

            </div>

        </header>


        <div class="page-content inventory-page">

            <section class="inventory-header">

                <div>
                    <p class="eyebrow">INVENTORY MANAGEMENT</p>

                    <h1>Products & Stock</h1>

                    <p class="page-description">
                        Manage your product catalogue, pricing and stock levels.
                    </p>
                </div>

              

            </section>


            @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
            {
                <div class="inventory-notice inventory-success">
                    @Model.SuccessMessage
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.LoadError))
            {
                <div class="inventory-notice inventory-error" role="alert">
                    @Model.LoadError
                </div>
            }


            <section class="inventory-summary">

                <article class="inventory-summary-card">
                    <span class="inventory-summary-label">Total Products</span>
                    <strong>@Model.TotalProducts</strong>
                </article>

                <article class="inventory-summary-card">
                    <span class="inventory-summary-label">In Stock</span>
                    <strong>@Model.InStockProducts</strong>
                </article>

                <article class="inventory-summary-card">
                    <span class="inventory-summary-label">Low Stock</span>
                    <strong>@Model.LowStockProducts</strong>
                </article>

                <article class="inventory-summary-card">
                    <span class="inventory-summary-label">Out of Stock</span>
                    <strong>@Model.OutOfStockProducts</strong>
                </article>

            </section>


            <section class="inventory-section">

                <div class="inventory-section-heading">

                    <div>
                        <h2>Product Catalogue</h2>
                        <p>Products, prices and available quantities.</p>
                    </div>

                    <span class="inventory-result-count" id="productResultCount" aria-live="polite">
                        @Model.Products.Count Products
                    </span>

                </div>


                <div class="inventory-toolbar">

                    <div class="inventory-search">
                        <span aria-hidden="true">⌕</span>

                        <input type="search" id="productSearch" placeholder="Search product name or SKU..."
                               aria-label="Search products" />
                    </div>


                    <div class="inventory-filters">

                        <select id="categoryFilter" class="inventory-filter" aria-label="Filter by category">

                            <option value="all">All Categories</option>

                        </select>


                        <select id="stockFilter" class="inventory-filter" aria-label="Filter by stock status">

                            <option value="all">All Stock Statuses</option>
                            <option value="in-stock">In Stock</option>
                            <option value="low-stock">Low Stock</option>
                            <option value="out-of-stock">Out of Stock</option>
                            <option value="inactive">Inactive</option>

                        </select>


                        <button type="button" id="clearProductFilters" class="inventory-clear-button">
                            Clear Filters
                        </button>

                    </div>

                </div>


                <div class="inventory-table-container">

                    <table class="inventory-table">

                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>SKU</th>
                                <th>Category</th>
                                <th>Unit</th>
                                <th>Cost Price</th>
                                <th>Selling Price</th>
                                <th>Quantity</th>
                                <th>Stock Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            @if (Model.Products.Count > 0)
                            {
                                @foreach (var product in Model.Products)
                                {
                                    var stockStatus = !product.IsActive
                                        ? "inactive"
                                        : product.QuantityInStock <= 0
                                            ? "out-of-stock"
                                            : product.QuantityInStock <= product.LowStockThreshold
                                                ? "low-stock"
                                                : "in-stock";

                                    var stockLabel = stockStatus switch
                                    {
                                        "inactive" => "Inactive",
                                        "out-of-stock" => "Out of Stock",
                                        "low-stock" => "Low Stock",
                                        _ => "In Stock"
                                    };

                                    <tr data-product-row data-category="@(product.Category ?? "")"
                                        data-stock-status="@stockStatus">

                                        <td class="inventory-product-name">
                                            @product.Name
                                        </td>

                                        <td>@product.Sku</td>

                                        <td>@(product.Category ?? "Uncategorised")</td>

                                        <td>@product.Unit</td>

                                        <td>₦@product.CostPrice.ToString("N2")</td>

                                        <td>₦@product.SellingPrice.ToString("N2")</td>

                                        <td>
                                            @product.QuantityInStock.ToString("0.###")
                                        </td>

                                        <td>
                                            <span class="stock-badge stock-badge--@stockStatus">
                                                @stockLabel
                                            </span>
                                        </td>

                                        <td>
                                            <a class="inventory-edit-link" asp-page="/Products/Edit"
                                               asp-route-id="@product.ProductId">
                                                Edit
                                            </a>
                                        </td>

                                    </tr>
                                }
                            }
                            else if (!string.IsNullOrWhiteSpace(Model.LoadError))
                            {
                                <tr>
                                    <td colspan="9">
                                        <div class="inventory-no-results">
                                            <h3>Unable to Load Products</h3>
                                            <p>Check the database connection and refresh the page.</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8">

                                        <div class="inventory-empty-state">

                                            <div class="inventory-empty-icon" aria-hidden="true">
                                                ▤
                                            </div>

                                            <h3>No Products Found</h3>

                                            <p>
                                                Your product catalogue is empty.
                                            </p>

                                            <a class="dashboard-primary-button" asp-page="/Products/Create">
                                                <span aria-hidden="true">+</span>
                                                Add Product
                                            </a>

                                        </div>

                                    </td>
                                </tr>
                            }

                            <tr id="noMatchingProducts" hidden>
                                <td colspan="8">
                                    <div class="inventory-no-results">
                                        <h3>No Matching Products</h3>
                                        <p>Try changing your search or filters.</p>
                                    </div>
                                </td>
                            </tr>

                        </tbody>

                    </table>

                </div>

            </section>


            <footer class="dashboard-footer">
                <span>TradeTrack · Business Management System</span>
                <span>All rights reserved.</span>
            </footer>

        </div>

    </main>

</div>


@section Scripts {
    <script src="~/js/inventory.js" asp-append-version="true"></script>
}