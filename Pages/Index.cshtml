@page
@model TradeTrack.Pages.IndexModel

@{
    ViewData["Title"] = "Overview";
    ViewData["TradeTrackDashboard"] = true;
}

<div class="app-shell">

    <partial name="_Sidebar" />

    <main class="main-panel">

        <header class="topbar">

            <div class="breadcrumb">
                <span>Workspace</span>
                <span aria-hidden="true">/</span>
                <strong>Overview</strong>
            </div>

            <div class="topbar-right">

                <a class="dashboard-primary-button" asp-page="/Products/Create">
                    <span aria-hidden="true">+</span>
                    Add Product
                </a>

                <span class="profile-avatar" aria-label="Business profile">
                    MB
                </span>

            </div>

        </header>


        <div class="page-content">

            <section class="welcome-row">

                <div>
                    <p class="eyebrow">BUSINESS MANAGEMENT</p>

                    <h1>Overview</h1>

                    <p class="page-description">
                        Monitor business performance and manage daily operations.
                    </p>
                </div>

            </section>


            <section class="dashboard-banner">

                <div class="banner-symbol" aria-hidden="true">↗</div>

                <div class="banner-copy">

                    <p class="banner-kicker">TRADETRACK</p>

                    <h2>Your business, organised.</h2>

                    <p>
                        Manage inventory, monitor sales and expenses,
                        and keep your business records organised.
                    </p>

                </div>

                <a class="banner-link" asp-page="/Products/Create">
                    Add Product
                    <span aria-hidden="true">→</span>
                </a>

            </section>


            <section class="metrics-section">

                <div class="section-heading">
                    <div>
                        <h2>Business Summary</h2>
                        <p>A summary of your business activity.</p>
                    </div>
                </div>

                <div class="metrics-grid">

                    <article class="metric-card">
                        <div class="metric-topline">
                            <span class="metric-label">Sales Today</span>
                            <span class="metric-icon sales-icon" aria-hidden="true">↗</span>
                        </div>

                        <p class="metric-value">@Model.SalesTodayDisplay</p>
                        <p class="metric-footnote">Completed sales today</p>
                    </article>


                    <article class="metric-card">
                        <div class="metric-topline">
                            <span class="metric-label">Products in Stock</span>
                            <span class="metric-icon product-icon" aria-hidden="true">▤</span>
                        </div>

                        <p class="metric-value">
                            @Model.ProductsInStockDisplay
                        </p>

                        <p class="metric-footnote">Active products with available stock</p>
                    </article>


                    <article class="metric-card">
                        <div class="metric-topline">
                            <span class="metric-label">Monthly Expenses</span>
                            <span class="metric-icon expense-icon" aria-hidden="true">↘</span>
                        </div>

                        <p class="metric-value">@Model.MonthlyExpensesDisplay</p>
                        <p class="metric-footnote">Recorded expenses this month</p>
                    </article>


                    <article class="metric-card">
                        <div class="metric-topline">
                            <span class="metric-label">Net Profit</span>
                            <span class="metric-icon profit-icon" aria-hidden="true">◎</span>
                        </div>

                        <p class="metric-value">@Model.NetProfitDisplay</p>
                        <p class="metric-footnote">Monthly earnings after recorded costs and expenses</p>
                    </article>

                </div>

            </section>


            <div class="dashboard-lower-grid">

                <section class="panel">

                    <div class="panel-heading">
                        <div>
                            <h2>Recent Activity</h2>
                            <p>Latest business transactions</p>
                        </div>

                        <span class="panel-count">0 Records</span>
                    </div>

                    <div class="empty-state">

                        <div class="empty-state-icon" aria-hidden="true">
                            ↔
                        </div>

                        <h3>No Recent Activity</h3>

                        <p>
                            Your latest business transactions will appear here.
                        </p>

                    </div>

                </section>


                <section class="panel">

                    <div class="panel-heading">
                        <div>
                            <h2>Stock Health</h2>
                            <p>Current inventory condition</p>
                        </div>

                        <span class="stock-indicator">
                            @Model.InventoryStatus
                        </span>
                    </div>

                    <div class="stock-empty">

                        <span class="stock-empty-icon" aria-hidden="true">▤</span>

                        <h3>Inventory Overview</h3>

                        <p>
                            @Model.LowStockProductsDisplay low-stock products
                            require attention.
                        </p>

                        <a class="dashboard-primary-button" asp-page="/Products/Index">
                            View Inventory
                        </a>

                    </div>

                    <div class="stock-panel-footer">
                        <span>Inventory Management</span>
                        <a asp-page="/Products/Index">View Products →</a>
                    </div>

                </section>

            </div>


            <section class="business-modules">

                <div class="section-heading">
                    <div>
                        <h2>Business Management</h2>
                        <p>Manage your business operations.</p>
                    </div>
                </div>

                <div class="module-grid">

                    <article class="module-card">

                        <div class="module-icon inventory-module-icon" aria-hidden="true">▤</div>

                        <div class="module-content">
                            <h3>Products & Stock</h3>

                            <p>
                                Manage product information, pricing,
                                quantities and inventory.
                            </p>
                        </div>

                        <a class="module-link" asp-page="/Products/Index">
                            View Inventory →
                        </a>

                    </article>

                    <article class="module-card">

                        <div class="module-icon sales-module-icon" aria-hidden="true">↗</div>

                        <div class="module-content">
                            <h3>Customers & Sales</h3>

                            <p>
                                Manage customer information,
                                sales transactions and payments.
                            </p>
                        </div>

                        <div class="module-links">

                            <a class="module-link" asp-page="/Customers/Index">
                                Manage Customers →
                            </a>

                            <a class="module-link" asp-page="/Sales/Index">
                                View Sales →
                            </a>

                        </div>

                    </article>


                    <article class="module-card">

                        <div class="module-icon expenses-module-icon" aria-hidden="true">₦</div>

                        <div class="module-content">
                            <h3>Expenses & Reports</h3>

                            <p>
                                Track business expenses, revenue
                                and financial performance.
                            </p>
                        </div>

                        <div class="module-links">

                            <a class="module-link" asp-page="/Expenses/Index">
                                View Expenses →
                            </a>

                            <a class="module-link" asp-page="/Reports/Index">
                                View Reports →
                            </a>

                        </div>

                    </article>
                </div>

            </section>


            <footer class="dashboard-footer">
                <span>TradeTrack · Business Management System</span>
                <span>All rights reserved.</span>
            </footer>

        </div>

    </main>

</div>