
@page
@model TradeTrack.Pages.IndexModel

@{
    ViewData["Title"] = "Overview";
    ViewData["TradeTrackDashboard"] = true;
}

<div class="app-shell">
    <aside class="sidebar">
        <a class="brand" asp-page="/Index" aria-label="TradeTrack home">
            <span class="brand-mark">T</span>
            <span class="brand-copy">
                <span class="brand-name">TradeTrack</span>
                <span class="brand-caption">SMALL BUSINESS TOOLS</span>
            </span>
        </a>

        <div class="workspace-card">
            <span class="workspace-avatar">MB</span>
            <span class="workspace-copy">
                <strong>My business</strong>
                <small>Workspace setup</small>
            </span>
            <span class="workspace-menu" aria-hidden="true">···</span>
        </div>

        <nav class="side-navigation" aria-label="Main navigation">
            <p class="nav-section-title">WORKSPACE</p>

            <a class="side-link active" asp-page="/Index" aria-current="page">
                <span class="nav-icon" aria-hidden="true">▦</span>
                <span>Overview</span>
            </a>

            <p class="nav-section-title nav-section-spaced">MANAGE</p>

            <span class="side-link nav-unavailable" aria-disabled="true">
                <span class="nav-icon" aria-hidden="true">▤</span>
                <span>Products & stock</span>
                <span class="nav-soon">NEXT</span>
            </span>

            <span class="side-link nav-unavailable" aria-disabled="true">
                <span class="nav-icon" aria-hidden="true">↗</span>
                <span>Sales</span>
            </span>

            <span class="side-link nav-unavailable" aria-disabled="true">
                <span class="nav-icon" aria-hidden="true">♙</span>
                <span>Customers</span>
            </span>

            <span class="side-link nav-unavailable" aria-disabled="true">
                <span class="nav-icon" aria-hidden="true">₦</span>
                <span>Expenses</span>
            </span>

            <p class="nav-section-title nav-section-spaced">INSIGHTS</p>

            <span class="side-link nav-unavailable" aria-disabled="true">
                <span class="nav-icon" aria-hidden="true">▥</span>
                <span>Reports</span>
            </span>
        </nav>

        <div class="sidebar-bottom">
            <div class="setup-note">
                <span class="setup-note-icon" aria-hidden="true">✳</span>
                <strong>Getting started</strong>
                <p>Your workspace is ready. Start with products and stock to build your business records.</p>
                <a href="#build-plan">View build plan <span aria-hidden="true">↗</span></a>
            </div>

            <div class="sidebar-footer">
                <span class="online-dot" aria-hidden="true"></span>
                Development version
            </div>
        </div>
    </aside>

    <main class="main-panel">
        <header class="topbar">
            <div class="breadcrumb">
                <span>Workspace</span>
                <span aria-hidden="true">/</span>
                <strong>Overview</strong>
            </div>

            <div class="topbar-right">
                <span class="environment-label">
                    <span class="environment-dot" aria-hidden="true"></span>
                    LOCAL PREVIEW
                </span>
                <span class="profile-avatar" aria-label="Muhammad Ishaq">MI</span>
            </div>
        </header>

        <div class="page-content">
            <section class="welcome-row">
                <div>
                    <p class="eyebrow">YOUR BUSINESS AT A GLANCE</p>
                    <h1>Overview</h1>
                    <p class="page-description">
                        Keep track of the numbers that matter to your business.
                    </p>
                </div>

                <span class="setup-status">
                    <span aria-hidden="true">●</span>
                    Initial setup
                </span>
            </section>

            <section class="getting-started-banner" aria-labelledby="banner-title">
                <div class="banner-symbol" aria-hidden="true">↗</div>

                <div class="banner-copy">
                    <p class="banner-kicker">WELCOME TO TRADETRACK</p>
                    <h2 id="banner-title">Build a clearer picture of your business.</h2>
                    <p>
                        Your dashboard is ready. Add products first, then record sales
                        and expenses to start seeing useful business figures here.
                    </p>
                </div>

                <a class="banner-link" href="#build-plan">
                    See what's next <span aria-hidden="true">→</span>
                </a>
            </section>

            <section class="metrics-section" aria-labelledby="metrics-heading">
                <div class="section-heading">
                    <div>
                        <h2 id="metrics-heading">Business summary</h2>
                        <p>Figures will reflect your records as features are added.</p>
                    </div>
                    <span class="data-label">NO RECORDS YET</span>
                </div>

                <div class="metrics-grid">
                    <article class="metric-card">
                        <div class="metric-topline">
                            <span class="metric-label">Sales today</span>
                            <span class="metric-icon sales-icon" aria-hidden="true">↗</span>
                        </div>
                        <p class="metric-value">₦0</p>
                        <p class="metric-footnote">
                            <span class="neutral-marker"></span>
                            No sales recorded yet
                        </p>
                    </article>

                    <article class="metric-card">
                        <div class="metric-topline">
                            <span class="metric-label">Products in stock</span>
                            <span class="metric-icon product-icon" aria-hidden="true">▤</span>
                        </div>
                        <p class="metric-value">0 <span class="metric-unit">items</span></p>
                        <p class="metric-footnote">
                            <span class="neutral-marker"></span>
                            Products not added yet
                        </p>
                    </article>

                    <article class="metric-card">
                        <div class="metric-topline">
                            <span class="metric-label">Expenses this month</span>
                            <span class="metric-icon expense-icon" aria-hidden="true">↘</span>
                        </div>
                        <p class="metric-value">₦0</p>
                        <p class="metric-footnote">
                            <span class="neutral-marker"></span>
                            No expenses recorded yet
                        </p>
                    </article>

                    <article class="metric-card">
                        <div class="metric-topline">
                            <span class="metric-label">Estimated profit</span>
                            <span class="metric-icon profit-icon" aria-hidden="true">◎</span>
                        </div>
                        <p class="metric-value">—</p>
                        <p class="metric-footnote">
                            Calculated when sales and costs are recorded
                        </p>
                    </article>
                </div>
            </section>

            <div class="dashboard-lower-grid">
                <section class="panel activity-panel" aria-labelledby="activity-heading">
                    <div class="panel-heading">
                        <div>
                            <h2 id="activity-heading">Recent activity</h2>
                            <p>Your latest business transactions</p>
                        </div>
                        <span class="panel-count">0 records</span>
                    </div>

                    <div class="empty-state">
                        <div class="empty-state-icon" aria-hidden="true">↔</div>
                        <h3>No activity to show</h3>
                        <p>
                            Sales and expense records will appear here once those
                            features are implemented and you begin adding entries.
                        </p>
                    </div>
                </section>

                <section class="panel stock-panel" aria-labelledby="stock-heading">
                    <div class="panel-heading">
                        <div>
                            <h2 id="stock-heading">Stock health</h2>
                            <p>Products that may need attention</p>
                        </div>
                        <span class="stock-indicator">Not set up</span>
                    </div>

                    <div class="stock-empty">
                        <span class="stock-empty-icon" aria-hidden="true">▤</span>
                        <h3>Inventory starts here</h3>
                        <p>
                            Once products and stock quantities are recorded, this
                            area can identify items running low.
                        </p>
                    </div>

                    <div class="stock-panel-footer">
                        <span>Low-stock alerts</span>
                        <span class="feature-status">Planned feature</span>
                    </div>
                </section>
            </div>

            <section class="build-plan" id="build-plan" aria-labelledby="build-plan-heading">
                <div class="section-heading">
                    <div>
                        <p class="eyebrow">PROJECT ROADMAP</p>
                        <h2 id="build-plan-heading">What we're building next</h2>
                        <p>Each module will be implemented and tested before moving on.</p>
                    </div>
                </div>

                <div class="roadmap-grid">
                    <article class="roadmap-card roadmap-current">
                        <span class="roadmap-number">01</span>
                        <div>
                            <h3>Products & stock</h3>
                            <p>Manage products, prices, quantities and restocking.</p>
                        </div>
                        <span class="roadmap-badge">UP NEXT</span>
                    </article>

                    <article class="roadmap-card">
                        <span class="roadmap-number">02</span>
                        <div>
                            <h3>Customers & sales</h3>
                            <p>Record sales, customer details and payments.</p>
                        </div>
                        <span class="roadmap-badge">PLANNED</span>
                    </article>

                    <article class="roadmap-card">
                        <span class="roadmap-number">03</span>
                        <div>
                            <h3>Expenses & reports</h3>
                            <p>Track spending, profit and business summaries.</p>
                        </div>
                        <span class="roadmap-badge">PLANNED</span>
                    </article>
                </div>
            </section>

            <footer class="dashboard-footer">
                <span>TradeTrack <span aria-hidden="true">·</span> Built for practical small-business management</span>
                <span>Development preview</span>
            </footer>
        </div>
    </main>
</div>
