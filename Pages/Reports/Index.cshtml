@page
@model TradeTrack.Pages.Reports.IndexModel

@{
    ViewData["Title"] = "Reports";
    ViewData["TradeTrackDashboard"] = true;
}

<div class="app-shell">

    <partial name="_Sidebar" />

    <main class="main-panel">

        <header class="topbar">

            <div class="breadcrumb">
                <span>Workspace</span>
                <span>/</span>
                <strong>Reports</strong>
            </div>

            <div class="topbar-right">
                <span class="profile-avatar">MB</span>
            </div>

        </header>

        <div class="page-content">

            <section class="inventory-header">
                <div>
                    <p class="eyebrow">BUSINESS INSIGHTS</p>
                    <h1>Reports</h1>
                    <p class="page-description">
                        Review revenue, expenses and business profitability.
                    </p>
                </div>
            </section>

            @if (!string.IsNullOrWhiteSpace(Model.LoadError))
            {
                <div class="inventory-notice inventory-error" role="alert">
                    @Model.LoadError
                </div>
            }

            <section class="report-filter-panel">

                <form method="get" class="report-filter-form">

                    <div class="expense-field">
                        <label for="FromDate">From Date</label>
                        <input id="FromDate"
                               name="FromDate"
                               type="date"
                               value="@Model.FromDate.ToString("yyyy-MM-dd")"
                               class="expense-control" />
                    </div>

                    <div class="expense-field">
                        <label for="ToDate">To Date</label>
                        <input id="ToDate"
                               name="ToDate"
                               type="date"
                               value="@Model.ToDate.ToString("yyyy-MM-dd")"
                               class="expense-control" />
                    </div>

                    <button type="submit" class="report-filter-button">
                        Apply Dates
                    </button>

                    <a asp-page-handler="ExportCsv"
                       asp-route-fromDate="@Model.FromDate.ToString("yyyy-MM-dd")"
                       asp-route-toDate="@Model.ToDate.ToString("yyyy-MM-dd")"
                       class="report-export-button">
                        Export CSV
                    </a>

                </form>

            </section>

            @if (string.IsNullOrWhiteSpace(Model.LoadError))
            {
                <section class="report-summary">

                    <article class="report-card">
                        <span>Sales Revenue</span>
                        <strong>₦@Model.TotalRevenue.ToString("N2")</strong>
                        <small>@Model.TransactionCount completed transactions</small>
                    </article>

                    <article class="report-card">
                        <span>Cost of Goods Sold</span>
                        <strong>₦@Model.CostOfGoodsSold.ToString("N2")</strong>
                        <small>Recorded cost of sold products</small>
                    </article>

                    <article class="report-card">
                        <span>Business Expenses</span>
                        <strong>₦@Model.TotalExpenses.ToString("N2")</strong>
                        <small>@Model.ExpenseCount expense records</small>
                    </article>

                    <article class="report-card report-profit-card">
                        <span>Net Profit</span>
                        <strong>₦@Model.NetProfit.ToString("N2")</strong>
                        <small>Revenue less product costs and expenses</small>
                    </article>

                </section>

                <section class="report-profit-breakdown">

                    <div>
                        <span>Gross Profit</span>
                        <strong>₦@Model.GrossProfit.ToString("N2")</strong>
                    </div>

                    <div>
                        <span>Sales Transactions</span>
                        <strong>@Model.TransactionCount.ToString("N0")</strong>
                    </div>

                    <div>
                        <span>Expense Records</span>
                        <strong>@Model.ExpenseCount.ToString("N0")</strong>
                    </div>

                </section>

                <section class="inventory-section report-table-section">

                    <div class="inventory-section-heading">
                        <div>
                            <h2>Sales Report</h2>
                            <p>Completed sales within the selected date range.</p>
                        </div>
                        <span class="inventory-result-count">
                            @Model.Sales.Count Transactions
                        </span>
                    </div>

                    <div class="inventory-table-container">

                        <table class="inventory-table">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Invoice</th>
                                    <th>Customer</th>
                                    <th>Items</th>
                                    <th>Revenue</th>
                                    <th>Cost</th>
                                </tr>
                            </thead>

                            <tbody>
                                @if (Model.Sales.Count > 0)
                                {
                                    @foreach (var sale in Model.Sales)
                                    {
                                        var cost = sale.Items.Sum(
                                            item => item.Quantity * item.UnitCost);

                                        <tr>
                                            <td>@sale.SaleDate.ToString("dd MMM yyyy")</td>
                                            <td class="inventory-product-name">
                                                @sale.InvoiceNumber
                                            </td>
                                            <td>
                                                @(sale.Customer?.FullName ?? "Walk-in Customer")
                                            </td>
                                            <td>@sale.Items.Count</td>
                                            <td>₦@sale.TotalAmount.ToString("N2")</td>
                                            <td>₦@cost.ToString("N2")</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6">
                                            <div class="inventory-no-results">
                                                <h3>No Sales in This Period</h3>
                                                <p>Completed sales will appear here.</p>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                    </div>

                </section>

                <section class="inventory-section report-table-section">

                    <div class="inventory-section-heading">
                        <div>
                            <h2>Expense Report</h2>
                            <p>Recorded expenses within the selected date range.</p>
                        </div>
                        <span class="inventory-result-count">
                            @Model.Expenses.Count Records
                        </span>
                    </div>

                    <div class="inventory-table-container">

                        <table class="inventory-table">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Expense</th>
                                    <th>Category</th>
                                    <th>Payment</th>
                                    <th>Amount</th>
                                </tr>
                            </thead>

                            <tbody>
                                @if (Model.Expenses.Count > 0)
                                {
                                    @foreach (var expense in Model.Expenses)
                                    {
                                        <tr>
                                            <td>@expense.ExpenseDate.ToString("dd MMM yyyy")</td>
                                            <td class="inventory-product-name">@expense.Title</td>
                                            <td>@expense.Category</td>
                                            <td>@expense.PaymentMethod</td>
                                            <td>₦@expense.Amount.ToString("N2")</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5">
                                            <div class="inventory-no-results">
                                                <h3>No Expenses in This Period</h3>
                                                <p>Recorded business expenses will appear here.</p>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                    </div>

                </section>
            }

            <footer class="dashboard-footer">
                <span>TradeTrack · Business Management System</span>
                <span>All rights reserved.</span>
            </footer>

        </div>

    </main>

</div>