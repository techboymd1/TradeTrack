@page
@model TradeTrack.Pages.Sales.IndexModel

@{
    ViewData["Title"] = "Sales";
    ViewData["TradeTrackDashboard"] = true;
}

<div class="app-shell">

    <partial name="_Sidebar" />

    <main class="main-panel">

        <header class="topbar">

            <div class="breadcrumb">
                <span>Workspace</span>
                <span>/</span>
                <strong>Sales</strong>
            </div>

            <div class="topbar-right">

                <a class="dashboard-primary-button"
                   asp-page="/Sales/Create">
                    + New Sale
                </a>

                <span class="profile-avatar">MB</span>

            </div>

        </header>

        <div class="page-content">

            <section class="inventory-header">

                <div>
                    <p class="eyebrow">BUSINESS MANAGEMENT</p>

                    <h1>Sales</h1>

                    <p class="page-description">
                        Review recorded transactions and sales performance.
                    </p>
                </div>

                <a class="dashboard-primary-button"
                   asp-page="/Sales/Create">
                    + New Sale
                </a>

            </section>

            @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
            {
                <div class="inventory-notice inventory-success">
                    @Model.SuccessMessage
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.LoadError))
            {
                <div class="inventory-notice inventory-error">
                    @Model.LoadError
                </div>
            }

            <section class="inventory-summary">

                <article class="inventory-summary-card">
                    <span class="inventory-summary-label">
                        Transactions Loaded
                    </span>
                    <strong>@Model.TotalTransactions</strong>
                </article>

                <article class="inventory-summary-card">
                    <span class="inventory-summary-label">
                        Recorded Revenue
                    </span>
                    <strong>₦@Model.TotalRevenue.ToString("N2")</strong>
                </article>

            </section>

            <section class="inventory-section">

                <div class="inventory-section-heading">
                    <div>
                        <h2>Sales History</h2>
                        <p>Latest 100 recorded transactions.</p>
                    </div>
                </div>

                <div class="inventory-table-container">

                    <table class="inventory-table">

                        <thead>
                            <tr>
                                <th>Invoice</th>
                                <th>Date</th>
                                <th>Items</th>
                                <th>Payment</th>
                                <th>Discount</th>
                                <th>Total</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>

                            @if (Model.Sales.Count > 0)
                            {
                                @foreach (var sale in Model.Sales)
                                {
                                    <tr>
                                        <td class="inventory-product-name">
                                            @sale.InvoiceNumber
                                        </td>

                                        <td>
                                            @sale.SaleDate.ToString("dd MMM yyyy, HH:mm")
                                        </td>

                                        <td>@sale.Items.Count</td>

                                        <td>@sale.PaymentMethod</td>

                                        <td>₦@sale.DiscountAmount.ToString("N2")</td>

                                        <td>
                                            <strong>₦@sale.TotalAmount.ToString("N2")</strong>
                                        </td>

                                        <td>
                                            <span class="stock-badge stock-badge--in-stock">
                                                @sale.Status
                                            </span>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7">
                                        <div class="inventory-empty-state">
                                            <h3>No Sales Recorded</h3>
                                            <p>Completed transactions will appear here.</p>

                                            <a class="dashboard-primary-button"
                                               asp-page="/Sales/Create">
                                                + Record First Sale
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </section>

            <footer class="dashboard-footer">
                <span>TradeTrack · Business Management System</span>
                <span>All rights reserved.</span>
            </footer>

        </div>

    </main>

</div>